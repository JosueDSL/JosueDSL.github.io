---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Grouped with a fold rather than Map.groupBy, which needs Node 21+ and breaks
// on the CI runner's Node. `posts` is already sorted newest-first, so appending
// to the trailing group preserves both year order and within-year order.
type YearGroup = [year: number, posts: typeof posts];

const postsByYear = posts.reduce<YearGroup[]>((groups, post) => {
  const year = post.data.pubDate.getUTCFullYear();
  const current = groups.at(-1);
  if (current && current[0] === year) current[1].push(post);
  else groups.push([year, [post]]);
  return groups;
}, []);
---

<BaseLayout
  title="Blog"
  description="Writing on backend engineering, system design, and software craft by Josue de Santos."
>
  <div class="page-header">
    <p class="eyebrow">Writing</p>
    <h1>Blog</h1>
    <p class="intro">
      Notes on backend engineering, system design, and things I learn along the way. · <a href="/blog/tags"
        >browse by tag</a
      >.
    </p>
  </div>
  {
    postsByYear.map(([year, yearPosts]) => (
      <section class="year-group">
        <h2>{year}</h2>
        <div>
          {yearPosts.map((post) => (
            <PostItem {post} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-7) var(--space-6);
  }

  h1 {
    font-size: var(--text-3xl);
    margin-block: var(--space-2) var(--space-3);
  }

  .intro {
    max-width: var(--content-width);
    color: var(--text-muted);
  }

  .year-group {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    max-width: 52rem;
    padding-block-end: var(--space-6);
  }

  .year-group h2 {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    padding-block-start: var(--space-4);
  }

  @media (max-width: 480px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
