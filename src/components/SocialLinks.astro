---
interface Props {
  showRss?: boolean;
}

const { showRss = false } = Astro.props;

const links = [
  {
    href: 'https://github.com/JosueDSL',
    label: 'GitHub',
    path: 'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.01 10.01 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z',
  },
  {
    href: 'https://www.linkedin.com/in/josuedesantos',
    label: 'LinkedIn',
    path: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z',
  },
  {
    href: 'https://www.youtube.com/playlist?list=PLMbdJMoTREYUy26fWNmroSh3tAqGFf9Vx',
    label: 'YouTube',
    path: 'M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81ZM9.6 15.6V8.4L15.83 12 9.6 15.6Z',
  },
  {
    href: 'mailto:contact@josueds.me',
    label: 'Email',
    path: 'M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13Zm2.24.5L12 12.25 19.76 6H4.24ZM20 7.8l-7.4 5.93a1 1 0 0 1-1.2 0L4 7.8V18h16V7.8Z',
  },
];
---

<ul class="social-links">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={link.path} />
          </svg>
        </a>
      </li>
    ))
  }
  {
    showRss && (
      <li>
        <a href="/rss.xml" aria-label="RSS feed">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73H19.6C19.6 11.42 12.6 4.44 4 4.44Zm0 5.66v2.83a7.07 7.07 0 0 1 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9ZM6.18 15.64a2.18 2.18 0 1 0 0 4.36 2.18 2.18 0 0 0 0-4.36Z" />
          </svg>
        </a>
      </li>
    )
  }
</ul>

<style>
  .social-links {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    color: var(--text-muted);
    transition: color var(--transition);
  }

  a:hover {
    color: var(--accent);
  }
</style>
